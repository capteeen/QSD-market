{
  "darkMode": [
    "selector",
    ":root:not([data-theme=\"brightfield\"])"
  ],
  "theme": {
    "extend": {
      "colors": {
        "void": "var(--qsd-void)",
        "panel": "var(--qsd-panel)",
        "border": "var(--qsd-border)",
        "probability": "var(--qsd-probability)",
        "collapse": "var(--qsd-collapse)",
        "decay": "var(--qsd-decay)",
        "tunnel": "var(--qsd-tunnel)",
        "dead": "var(--qsd-dead)",
        "text": "var(--qsd-text)",
        "muted": "var(--qsd-muted)",
        "gold": "var(--qsd-gold)",
        "ice": "var(--qsd-ice)",
        "glass": "var(--qsd-glass)",
        "glass-edge": "var(--qsd-glass-edge)",
        "glow-inner": "#F2C46D",
        "glow-outer": "#FFFFFF",
        "void-hex": "#0F0E0D",
        "panel-hex": "#161514",
        "border-hex": "#2A2724",
        "probability-hex": "#5FBF6A",
        "collapse-hex": "#E5484D",
        "decay-hex": "#E2B04A",
        "tunnel-hex": "#F5F2EC",
        "dead-hex": "#4A4642",
        "text-hex": "#EDEAE4",
        "muted-hex": "#8C8780",
        "gold-hex": "#F0A845",
        "ice-hex": "#5B9BD5"
      },
      "fontFamily": {
        "mono": [
          "'JetBrains Mono'",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "heading": [
          "'Space Grotesk'",
          "system-ui",
          "-apple-system",
          "'Segoe UI'",
          "sans-serif"
        ]
      },
      "fontSize": {
        "xs": "0.6875rem",
        "sm": "0.8125rem",
        "base": "0.9375rem",
        "lg": "1.125rem",
        "xl": "1.5rem",
        "2xl": "2.25rem",
        "3xl": "3.5rem"
      },
      "fontWeight": {
        "heading": "600"
      },
      "borderWidth": {
        "rule": "1px",
        "card": "2px"
      },
      "borderRadius": {
        "card": "0px",
        "quantum": "9999px"
      },
      "boxShadow": {
        "glow-compute": "0 0 2px #FFFFFF, 0 0 8px rgba(242,196,109,0.9), 0 0 24px rgba(242,196,109,0.55), 0 0 64px rgba(242,196,109,0.25)",
        "glass-edge": "inset 0 0 0 1px rgba(245,242,236,0.07)"
      },
      "backgroundImage": {
        "glow-compute-radial": "var(--glow-compute-radial)"
      },
      "transitionTimingFunction": {
        "viscous": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "transitionDuration": {
        "slow": "700ms",
        "slower": "1400ms",
        "collapse": "120ms"
      },
      "backdropBlur": {
        "glass": "var(--qsd-glass-blur)"
      }
    }
  },
  "plugins": []
}
