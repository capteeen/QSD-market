{
  "darkMode": [
    "selector",
    ":root:not([data-theme=\"brightfield\"])"
  ],
  "theme": {
    "extend": {
      "colors": {
        "void": "var(--qsd-void)",
        "panel": "var(--qsd-panel)",
        "border": "var(--qsd-border)",
        "probability": "var(--qsd-probability)",
        "collapse": "var(--qsd-collapse)",
        "decay": "var(--qsd-decay)",
        "tunnel": "var(--qsd-tunnel)",
        "dead": "var(--qsd-dead)",
        "text": "var(--qsd-text)",
        "muted": "var(--qsd-muted)",
        "gold": "var(--qsd-gold)",
        "ice": "var(--qsd-ice)",
        "paper": "var(--qsd-paper)",
        "ink": "var(--qsd-ink)",
        "line": "var(--qsd-line)",
        "rim": "var(--qsd-rim)",
        "teal": "var(--qsd-teal)",
        "violet": "var(--qsd-violet)",
        "glass": "var(--qsd-glass)",
        "glass-edge": "var(--qsd-glass-edge)",
        "glow-inner": "#E7FF9C",
        "glow-outer": "#FFFFFF",
        "void-hex": "#252423",
        "panel-hex": "#2E2D2C",
        "border-hex": "#3D3B39",
        "probability-hex": "#AFF902",
        "collapse-hex": "#FF6B5E",
        "decay-hex": "#8ED600",
        "tunnel-hex": "#F5F2EC",
        "dead-hex": "#57544F",
        "text-hex": "#F2EFE9",
        "muted-hex": "#9A958D",
        "gold-hex": "#AFF902",
        "ice-hex": "#6FA2FF",
        "paper-hex": "#D9D7D2",
        "ink-hex": "#262524",
        "line-hex": "#8A8781",
        "rim-hex": "#E7FF9C",
        "teal-hex": "#5CDFB4",
        "violet-hex": "#B18BFF"
      },
      "fontFamily": {
        "mono": [
          "'JetBrains Mono'",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "heading": [
          "'Space Grotesk'",
          "system-ui",
          "-apple-system",
          "'Segoe UI'",
          "sans-serif"
        ]
      },
      "fontSize": {
        "xs": "0.6875rem",
        "sm": "0.8125rem",
        "base": "0.9375rem",
        "lg": "1.125rem",
        "xl": "1.5rem",
        "2xl": "2.25rem",
        "3xl": "3.5rem"
      },
      "fontWeight": {
        "heading": "600"
      },
      "borderWidth": {
        "rule": "1px",
        "card": "1px"
      },
      "borderRadius": {
        "card": "8px",
        "quantum": "9999px"
      },
      "boxShadow": {
        "glow-compute": "0 0 2px #FFFFFF, 0 0 8px rgba(175,249,2,0.9), 0 0 24px rgba(175,249,2,0.55), 0 0 64px rgba(175,249,2,0.25)",
        "glass-edge": "inset 0 0 0 1px rgba(245,242,236,0.06)"
      },
      "backgroundImage": {
        "glow-compute-radial": "var(--glow-compute-radial)"
      },
      "transitionTimingFunction": {
        "viscous": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "transitionDuration": {
        "slow": "700ms",
        "slower": "1400ms",
        "collapse": "120ms"
      },
      "backdropBlur": {
        "glass": "var(--qsd-glass-blur)"
      }
    }
  },
  "plugins": []
}
