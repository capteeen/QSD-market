# ─────────────────────────────────────────────────────────────────────────────
# qsd.market — apps/web environment
# Every variable the app and its packages read. Nothing has a made-up default:
# a missing value makes the corresponding page or action report "not available".
# ─────────────────────────────────────────────────────────────────────────────

# ── app ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://qsd:qsd@localhost:5432/qsd
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Public: which cluster the browser talks to (wallet adapter, explorer links). devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public: optional RPC for the wallet adapter (defaults to the cluster's public RPC)
NEXT_PUBLIC_SOLANA_RPC_URL=
# Public: comma-separated published witness public keys (64 hex each) for in-browser verify();
# must equal QSD_WITNESS_PUBLIC_KEYS. Empty → every bundle renders "invalid: no trusted key".
NEXT_PUBLIC_QSD_WITNESS_PUBLIC_KEYS=

# Launch cost breakdown (lamports, integers). Unset → /launch shows "not available" and refuses to launch.
QSD_LAUNCH_COST_LAMPORTS=
QSD_IDENTITY_RESERVE_LAMPORTS=
# Generation-1 channel table + genesis band + devnet supply (JSON file; see README "Genesis config").
QSD_GENESIS_CONFIG=./genesis.example.json   # copy and edit for a real deployment
# Dev buy in SOL for automatically launched daughters (mainnet pump.fun). 0 on devnet.
QSD_DAUGHTER_DEV_BUY_SOL=0
# Optional override of the docs directory rendered on /how (default: walk up from cwd to find docs/physics.md).
QSD_DOCS_DIR=

# ── @qsd/solana (see packages/solana/README.md §1) ───────────────────────────
SOLANA_CLUSTER=devnet                 # devnet | mainnet-beta
QSD_MAINNET_ENABLED=                  # must be "true" to run on mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=                       # DAS snapshots + webhooks (optional on devnet)
PUMPPORTAL_API_URL=https://pumpportal.fun/api   # mainnet only
PINATA_JWT=                           # mainnet launches (pump.fun IPFS metadata)
JUPITER_API_URL=https://api.jup.ag    # mainnet buy-and-burn
JUPITER_API_KEY=
QSD_KEY_ENCRYPTION_KEY=               # REQUIRED: 64 hex chars (32 bytes); encrypts every key at rest
QSD_PROTOCOL_CREATOR_SECRET=          # EncryptedBlob JSON or path; mainnet required (devnet: searched in the key store)
QSD_KEYSTORE_PATH=./var/keystore.json # file-backed key store + identity reserve (<path>.reserve.json); mainnet required
QSD_JOURNAL_DIR=./var/journals        # airdrop / collapse / burn / measurement journals (crash-resume)
QSD_TOKEN_MINT=                       # the $QSD mint; unset → no hourly burn, /burns shows "no $QSD mint is configured"
QSD_FEE_WALLET=                       # fee wallet = the protocol creator (sender payer) for the burn job
QSD_WEBHOOK_SECRET=                   # Helius webhook authHeader; unset → every webhook is refused

# ── @qsd/quantum (see packages/quantum/README.md) ────────────────────────────
QSD_QRNG_PROVIDER=anu-quantum-numbers # or UNSAFE_DEV_RANDOM (only with NODE_ENV=test, or development + QSD_ALLOW_UNSAFE_DEV=1)
QSD_QRNG_API_KEY=                     # ANU Quantum Numbers API key
QSD_QRNG_ENDPOINT=                    # optional endpoint override
QSD_WITNESS_SECRET_KEY=               # 64 hex: Ed25519 seed of the QSD witness key (producer side)
QSD_WITNESS_PUBLIC_KEYS=              # comma-separated published witness public keys (verifier side)
QSD_ALLOW_UNSAFE_DEV=                 # "1" to allow UNSAFE_DEV_RANDOM under NODE_ENV=development

# ── devnet vs mainnet ────────────────────────────────────────────────────────
# devnet : SOLANA_CLUSTER=devnet, NEXT_PUBLIC_SOLANA_CLUSTER=devnet. Launches mint a plain SPL
#          token (pump.fun has no devnet); no $QSD, so no burn; Helius optional.
# mainnet: SOLANA_CLUSTER=mainnet-beta + QSD_MAINNET_ENABLED=true + NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta,
#          PINATA_JWT, QSD_PROTOCOL_CREATOR_SECRET, QSD_KEYSTORE_PATH, QSD_JOURNAL_DIR, QSD_TOKEN_MINT,
#          QSD_FEE_WALLET, JUPITER_API_KEY, HELIUS_API_KEY, QSD_WEBHOOK_SECRET, and the ANU + witness keys.
