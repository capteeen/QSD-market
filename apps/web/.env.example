# ─────────────────────────────────────────────────────────────────────────────
# INFINITWAP — apps/web environment
# Every variable the app and its packages read. Nothing has a made-up default:
# a missing value makes the corresponding page or action report "not available".
# Not an official Kinetiq or Hyperliquid product.
# ─────────────────────────────────────────────────────────────────────────────

# ── app ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://infinitwap:infinitwap@localhost:5432/infinitwap
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Public: which network the browser talks about. testnet (default) | mainnet
# mainnet is refused by the server: Elysium mainnet chain ID, RPC and explorer are not published.
NEXT_PUBLIC_ELYSIUM_NETWORK=testnet
# Public RPC for the browser wallet. Leave empty to use https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_RPC_URL=
# Public: comma-separated published witness public keys (64 hex each) for in-browser verify();
# must equal QSD_WITNESS_PUBLIC_KEYS. Empty → every bundle renders "invalid: no trusted key".
NEXT_PUBLIC_QSD_WITNESS_PUBLIC_KEYS=

# Launch cost breakdown, in wei of HYPE (integers). The variable names still say LAMPORTS; the values are wei.
# Unset → /launch shows "not available" and refuses to launch.
# The user pays the sum: launch fee + identity reserve + the fixed dev buy.
QSD_LAUNCH_COST_LAMPORTS=1000000000000000
QSD_IDENTITY_RESERVE_LAMPORTS=1000000000000000
QSD_LAUNCH_DEV_BUY_LAMPORTS=0
# Generation-1 channel table + genesis band (JSON file; see README "Genesis config").
QSD_GENESIS_CONFIG=./genesis.example.json   # a file path, or the JSON itself on one line
# Daughter launches need a published pool. Until one exists, collapse reports that and creates no coin.
QSD_DAUGHTER_DEV_BUY_MAX_SOL=0.1
QSD_REWARD_SHORTFALL_MAX_SOL=0
QSD_MAX_COLLAPSES_PER_DAY=3
# Launch phase: every new coin gets a 30-second half-life and is auto-measured after 60 quiet seconds.
QSD_FAST_LAUNCH_PHASE=false
# Optional override of the docs directory rendered on /how.
QSD_DOCS_DIR=

# ── Elysium (see packages/elysium/README.md) ─────────────────────────────────
ELYSIUM_NETWORK=testnet                 # testnet only; mainnet throws
ELYSIUM_RPC_URL=                        # optional; empty → public https://testnet-rpc.elysium.kinetiq.xyz
ELYSIUM_ALCHEMY_API_KEY=                # optional; used only when ELYSIUM_RPC_URL is empty
ELYSIUM_DEPLOYER_PRIVATE_KEY=           # REQUIRED to launch: 32-byte hex. Never log it. Pays HYPE gas and receives the token supply.
QSD_KEY_ENCRYPTION_KEY=                 # REQUIRED to launch: 64 hex chars (32 bytes); encrypts identity material at rest
# Keys, identity state and journals live in Postgres (table ChainKv) by default.
QSD_KEYSTORE_PATH=
QSD_JOURNAL_DIR=
QSD_TOKEN_MINT=                         # optional INFINITWAP address shown on /burns; unset → "no INFINITWAP token is configured"
QSD_WEBHOOK_SECRET=                     # unused: /api/webhooks/helius returns 501 and stores nothing

# ── @qsd/quantum (see packages/quantum/README.md) ────────────────────────────
QSD_QRNG_PROVIDER=anu-quantum-numbers # or UNSAFE_DEV_RANDOM (only with NODE_ENV=test, or development + QSD_ALLOW_UNSAFE_DEV=1)
QSD_QRNG_API_KEY=
QSD_QRNG_ENDPOINT=
QSD_WITNESS_SECRET_KEY=               # 64 hex: Ed25519 seed of the witness key (producer side)
QSD_WITNESS_PUBLIC_KEYS=
QSD_ALLOW_UNSAFE_DEV=
